{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuo-learning-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuo-learning-db",
      "database_id": "8f9c116e-728c-4c29-9fae-a266666a28c1",
      "migrations_dir": "drizzle"
    }
  ],
  "assets": {
    "directory": "./exams",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "account_id": "c6146cc59d61c594f9b23499e9aa8af5"
}
